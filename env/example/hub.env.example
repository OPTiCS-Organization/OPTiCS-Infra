# OPTiCS-Infra/env/hub.env로 복사 후 값을 수정해주세요.
# compose로 실행하는 경우에는 수정하지 않아도 동작은 합니다..

# MySQL 연결 설정
DATABASE_URL="mysql://root:1234@mysql:3306/optics"
DATABASE_USER="root"
DATABASE_PASSWORD="1234"
DATABASE_PORT="3306"
DATABASE_HOST="mysql"
DATABASE_NAME="optics"

# JWT 서명 키 (openssl rand -hex 96)
SECURITY_JWT_SECRET="CHANGE_ME"
SECURITY_ACCESS_TTL=5m
SECURITY_REFRESH_TTL=7d
SECURITY_TERMINAL_SSH_TTL=2m
SECURITY_VERIFY_REGISTER_TOTP_TTL=5m
SECURITY_SALT_ROUND=12

# 프록시 ↔ 허브 간 통신 시크릿 키
TUNNEL_INTERNAL_SECRET=CHANGE_ME
TUNNEL_PORT=5220

# Agent 이벤트의 HMAC 서명 검증을 강제할지 여부.
# false면 검증 실패를 SIGNATURE:REJECTED 로그로만 남기고 통과시킨다.
# 서명을 붙이지 않는 구버전 Agent가 남아 있을 수 있으므로, 로그가 0이 된 것을
# 확인한 뒤에 true로 올린다.
AGENT_SIGNATURE_ENFORCED=false

# 허용할 프론트엔드 오리진 (쉼표로 구분, 공백 없이)
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost:443,http://localhost

# Sentry
SENTRY_DSN=https://yoursentrydsn.ingest.de.sentry.io/12341234

# 클라우드 플레어 DNS에서 DNS Edit 권한이 있는 API 키
CLOUDFLARE_API_KEY=abcd_....
# 클라우드 플레어 도메인을 식별할 수 있는 ZONE ID
CLOUDFLARE_ZONE_ID=d713....

TOTP_PERIOD_SECONDS=30
TOTP_EPOCH_TOLERANCE_SECONDS=30

SERVER_PORT=3000
